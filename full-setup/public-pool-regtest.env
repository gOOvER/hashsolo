BITCOIN_RPC_URL=http://bitcoin-regtest
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=bitcoin
BITCOIN_RPC_PORT=28332
BITCOIN_RPC_TIMEOUT=10000

# Enable in bitcoin-regtest.conf with:
# zmqpubhashblock=tcp://0.0.0.0:3000
# BITCOIN_ZMQ_HOST=tcp://bitcoin-regtest:3000

API_PORT=23334
STRATUM_PORT=23333
STRATUM_START_DIFF=0.001
VARDIFF_TARGET_TIME=10
VARDIFF_MIN_DIFF=0.00001
POOL_IDENTIFIER=HashSolo

# Optional Telegram bot
#TELEGRAM_BOT_TOKEN=

# Optional Discord bot (Components V2)
#DISCORD_BOT_TOKEN=
#DISCORD_BOT_CLIENTID=
#DISCORD_BOT_GUILD_ID=
#DISCORD_BOT_CHANNEL_ID=

# Optional ntfy alerts
#NTFY_URL=
#NTFY_TOPIC=
#NTFY_TOKEN=
BEST_DIFF_ALERT_MIN=1
DEVICE_NOTIFICATIONS_ENABLED=true

# Optional Dev-Fee (>= 50 TH/s: 1.5%, < 50 TH/s: 0%)
DEV_FEE_ADDRESS=

# mainnet | testnet | regtest
NETWORK=regtest

API_SECURE=false
CORS_ORIGIN=*
